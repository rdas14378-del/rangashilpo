generator client {
  provider      = "prisma-client-js"
  engineType    = "wasm"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model PriceOverride {
  id        String   @id @default(cuid())
  productId String   @unique
  price     Int
  updatedAt DateTime @updatedAt

  @@map("price_overrides")
}